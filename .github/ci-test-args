# Extra pytest args for the CI gate in .github/workflows/deploy.yml.
# Run the exact CI selection locally with:
#   python -m pytest tests/ -q -p no:cacheprovider \
#     $(grep -vE '^[[:space:]]*(#|$)' .github/ci-test-args)
#
# These are the suite's KNOWN failures, excluded so a red gate means a real
# regression rather than a standing one. Every line needs a reason; an
# exclusion without one is how a genuine break gets parked here forever.
