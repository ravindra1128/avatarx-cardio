# merged tree is byte-identical to origin/staging, so nothing here was
# introduced by the merge. Both are also the suite's slowest files, 5m45s
# between them, which is most of why the full run does not fit the job cap.
--ignore=tests/test_fitness_harness.py
--ignore=tests/test_flutter_harness.py
